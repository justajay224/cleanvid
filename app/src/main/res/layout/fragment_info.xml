<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InfoFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Informasi Aplikasi" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout"> <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/question1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bagaimana cara menggunakan aplikasi?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:drawableEnd="@android:drawable/ic_menu_add"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/answer1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:text="1. Login dengan akun Google yang memiliki channel YouTube.\n\n2. Di halaman Home, tekan 'Fast Clean' untuk memindai 3 video terbaru Anda secara otomatis.\n\n3. Di halaman Search, masukkan link video spesifik yang ingin Anda pindai, lalu tekan 'Clean Video'."
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/question2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Apakah komentar benar-benar dihapus?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:drawableEnd="@android:drawable/ic_menu_add"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/answer2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tidak. Komentar spam tidak dihapus permanen, melainkan statusnya diubah menjadi 'rejected' (ditolak). Artinya, hanya si pemberi komentar yang masih bisa melihat komentarnya. Pemilik channel dan penonton lain tidak akan bisa melihatnya lagi."
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/question3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kenapa pembersihan video gagal?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:drawableEnd="@android:drawable/ic_menu_add"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/answer3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pembersihan hanya dapat dilakukan pada video yang berstatus 'Publik' atau 'Tidak Publik' (Unlisted).\n\nAplikasi tidak dapat memindai video yang berstatus 'Privat', 'Dijadwalkan', atau video yang komentarnya dinonaktifkan."
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible"/>

    </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>