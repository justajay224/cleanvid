<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/black"
    tools:context=".SearchFragment">

    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="317dp"
        android:layout_height="224dp"
        android:layout_marginBottom="100dp"
        android:contentDescription="Logo App"
        android:src="@drawable/logo_cleanvid" />

    <TextView
        android:id="@+id/notificationTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:text="Status notifikasi muncul di sini" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp">

        <EditText
            android:id="@+id/urlEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:hint="Input URL Video"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/pasteButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:text="PASTE"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF5757"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="#FF5757"/>
    </LinearLayout>

    <Button
        android:id="@+id/checkSpamButton"
        android:layout_width="210dp"
        android:layout_height="60dp"
        android:text="Periksa Spam "
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#FF5757"
        app:cornerRadius="30dp" />


</LinearLayout>



